{
  "name": "jsonx",
  "version": "0.1.0",
  "description": "A fast JSON formatter built for large files. Your JSON never leaves your browser.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:wasm": "wasm-pack build rust-core --target web --out-dir ../src/wasm --out-name jsonx_core",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/commands": "^6.3.3",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/language": "^6.10.0",
    "@lezer/highlight": "^1.2.0",
    "@codemirror/search": "^6.5.5",
    "@codemirror/state": "^6.4.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.24.0",
    "codemirror": "^6.0.1",
    "vue": "^3.4.15"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.6.2",
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "5.3.3",
    "vite": "^4.5.2",
    "vue-tsc": "^1.8.27"
  }
}
